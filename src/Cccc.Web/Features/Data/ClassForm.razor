@inject Dialogs D
<DialogFrame Title="@(_old is null ? "Add a class" : "Edit " + _old.Name)" OnOk="Save" OkEnabled="@(_name.Trim().Length > 0)">
    <ChildContent>
        <label class="field"><span>Name</span><input @bind="_name" @bind:event="oninput" /></label>
        <Colour @bind-Value="_colour" />
        <label class="field"><span>Area</span>
            <select @bind="_area">
                <option value="">No area</option>
                @foreach (var a in W.T.Areas.OrderBy(a => a.Name, NameOrder.Comparer))
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>
        </label>
        <label class="field"><span>How it counts for a student</span>
            <select @bind="_workload">
                @foreach (var w in Enum.GetValues<Workload>())
                {
                    <option value="@w">@WorkloadWords.For(w)</option>
                }
            </select>
        </label>
        <label class="field"><span>How hard it is on the body</span>
            <select @bind="_effort" data-testid="class-effort">
                @foreach (var e in Enum.GetValues<Effort>())
                {
                    <option value="@e">@EffortWords.For(e)</option>
                }
            </select>
        </label>
        <EquipmentTicks Chosen="_needs" Label="What it cannot be taught without" TestId="class-needs" />
        <p class="hint">Counted: required, part of a student's hours. Open session: optional (open training), can be hidden from the week. Not counted: on the timetable, never a student's hours (lunch).
            A Hard class is part of a group's hard training: the plan shows each group's, and warns past the school's limits in Settings.
            In a space without what it cannot be taught without, it is in the wrong space, and the plan says so.
        @if (_old is not null)
        {
            <span>Renaming a class renames the classes on the timetable still carrying its old name, in weeks that have not ended.</span>
        }
        </p>
        @if (_old is not null && FormerWords.For(W.T, _old, W.Today) is { } said)
        {
            <p class="@(_old.IsFormer() ? "notice" : "hint")" data-testid="former-note">@said</p>
        }
    </ChildContent>
    <Extra>
        @if (_old is not null)
        {
            @if (_old.IsFormer())
            {
                <button type="button" class="btn" @onclick="BringBack" data-testid="bring-back">Bring back</button>
            }
            else
            {
                <button type="button" class="btn danger" @onclick="Delete" data-testid="data-delete">Delete</button>
            }
            @if (W.T.Classes.Current().Any(c => c.Id != _old.Id))
            {
                <button type="button" class="btn" @onclick="Merge" data-testid="class-merge">Merge into…</button>
            }
        }
    </Extra>
</DialogFrame>
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    [Parameter] public Guid? Id { get; set; }
    private Class? _old;
    private string _name = "", _colour = "#5E35B1", _area = "";
    private Workload _workload;
    private Effort _effort;
    private HashSet<Guid> _needs = [];

    protected override void OnInitialized()
    {
        _old = Id is { } id ? W.T.Classes[id] : null;
        if (_old is null) return;
        _name = _old.Name; _colour = _old.Colour; _area = _old.AreaId?.ToString() ?? ""; _workload = _old.Workload; _effort = _old.Effort; _needs = [.. _old.Needs];
    }

    private void Save()
    {
        // In the school's order, and only what it still lists: a piece taken off the list since is nobody's.
        var needs = W.T.Equipment.Where(e => _needs.Contains(e.Id)).OrderBy(e => e.Name, NameOrder.Comparer).Select(e => e.Id);
        var c = (_old ?? new Class()) with { Name = _name.Trim(), Colour = _colour, AreaId = Guid.TryParse(_area, out var a) ? a : null, Workload = _workload, Effort = _effort, Needs = [.. needs] };
        if (W.Commit(t => Edits.PutClass(t, c, W.Today))) D.Close();
    }

    private void Delete()
    {
        if (W.Commit(t => Edits.RemoveClass(t, _old!.Id, W.Today))) D.Close();
    }

    private void BringBack()
    {
        if (W.Commit(t => Edits.BringBack(t, t.Classes[_old!.Id] ?? throw new EditRefused("That class has gone.")))) D.Close();
    }

    private void Merge() => D.Show<MergeClassForm>(new Dictionary<string, object?> { [nameof(MergeClassForm.Id)] = _old!.Id });
}
