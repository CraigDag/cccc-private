@page "/"
@inject PlanView V
@inject NavigationManager Nav
@using Cccc.Web.Features.Week
@using Cccc.Web.Features.Plan
@using Cccc.Web.Features.Ask
@inject Dialogs D
@inject SeenNews Seen

<PageTitle>Now · CCCC Scheduler</PageTitle>
@{
    var t = W.T;
    var today = W.Today;
    var local = W.Clock.Local(W.Clock.Now);
    int now = local.Hour * 60 + local.Minute;
    var all = Occurrences.Between(t, today, today).Where(o => !Guests.IsGuestOnly(t, o.Session)).ToList();
    var happening = all.Where(o => o.Happens).OrderBy(o => o.Start).ToList();
    var events = EventSchedule.Between(t, today, today, W.Access.Events);
    var cover = Cover.StillNeeded(t, today, today).Where(o => o.Date == today).ToList();
    var registers = Registers.FileableBy(Registers.MissingBetween(t, today, today, today.AddDays(1)), W.Access.Registers)
        .Where(o => PlanModel.Minutes(o.End) <= now).ToList();
    // Registers from earlier days: somebody linked to a facilitator gets their own (My week lists them);
    // an administrator linked to nobody gets the school's (Reports lists them). Today's are lines of their own.
    var earlier = W.Access.FacilitatorId is { } linked ? Registers.StillToTake(t, linked, today)
        : W.Access.MayTakeEveryRegister ? Registers.MissingBetween(t, Registers.EarlierFrom(today), today.AddDays(-1), today)
        : Array.Empty<Occurrence>();
    var todayIds = all.Select(o => o.Session.Id).ToHashSet();
    var clashes = Clashes.ForWeek(t, today).Where(c => c.IsRing && c.SessionIds.Any(todayIds.Contains)).ToList();
    var closure = Occurrences.ClosureFor(t, today, null);
    var semester = t.SemesterFor(today);
    int needs = cover.Count + registers.Count + clashes.Count + (earlier.Count > 0 ? 1 : 0);
    // Today's classes that changed since the weekday before began, from the timetable's own history, so a
    // change made late yesterday or this morning is seen by whoever opens Now. Guest classes stay hidden.
    // Somebody linked to a facilitator is told what is new for them from the last two weeks of it: one reading serves both.
    var since = Recent.Since(today);
    bool coach = W.Access.FacilitatorId is { } lf && t.Facilitators[lf] is not null;
    var read = W.Project is { } live ? live.ChangesMadeSince(W.Clock.StartOf(coach ? News.ReadFrom(today) : since)) : [];
    var sinceStart = W.Clock.StartOf(since);
    var changed = Recent.ForDay(t, read.Where(c => c.At >= sinceStart), today).Where(c => !Guests.IsGuestOnly(t, (c.Now ?? c.Was)!)).ToList();
    // Every space's little day bar shares one frame: the school day, widened to whatever is on today.
    int day0 = Math.Min(8 * 60, happening.Select(o => PlanModel.Minutes(o.Start) / 60 * 60).DefaultIfEmpty(8 * 60).Min());
    int day1 = Math.Max(18 * 60, happening.Select(o => (PlanModel.Minutes(o.End) + 59) / 60 * 60).DefaultIfEmpty(18 * 60).Max());
    // What facilitators have asked an administrator: can't come, and can cover. Only an administrator answers.
    var requests = W.Access.MayAnswerAsking ? Asking.RequestsWaiting(t, today) : [];
    var offers = W.Access.MayAnswerAsking ? Asking.OffersWaiting(t, today) : [];
    var spaceAsks = W.Access.MayAnswerAsking ? Asking.SpaceAsksWaiting(t, today, W.Clock.TimeOfDay) : [];
}

<div class="now" data-testid="now-page" data-minute="@Cccc.Domain.Week.Hm(new TimeOnly(local.Hour, local.Minute))">
    <header class="now-head">
        <h1 class="display"><span>@PlanPage.Long(today)</span> <span class="now-clock" data-now-clock>@Cccc.Domain.Week.Hm(new TimeOnly(local.Hour, local.Minute))</span></h1>
        <div class="muted">Week @Cccc.Domain.Week.IsoNumber(today) · @(semester?.Name ?? "Outside every semester")
            @if (closure is not null)
            {
                <span class="badge warn">Closed: @closure.Name</span>
            }
            <FollowingNotice Badge="true" />
        </div>
        @if (W.Access.MayCallTheRoll)
        {
            <a class="btn quiet now-roll" href="roll-call" data-testid="now-roll-call">Roll call</a>
        }
    </header>

    <div class="now-body">
        <section class="now-building" aria-label="The building now">
            @if (W.Access.FacilitatorId is { } me && t.Facilitators[me] is { } person)
            {
                // A coach's own day first: what they teach today, their part of a shared class, guests included.
                var mine = Occurrences.Between(t, today, today)
                    .Where(o => o.Session.FacilitatorIds.Contains(me) || o.Session.CoverIds.Contains(me))
                    .OrderBy(o => o.Start).ToList();
                // What changed for them since yesterday: on their own rows, and the classes they no longer
                // have today (moved away, deleted, or given to somebody else) as rows of their own.
                var changedById = changed.ToDictionary(c => c.Id);
                var gone = ChangeWords.NoLongerTheirs(changed, me, today);
                <h2 class="now-section">You today</h2>
                @if (mine.Count == 0 && gone.Count == 0)
                {
                    <p class="muted" data-testid="you-today">Nothing on for you today.</p>
                }
                else
                {
                    <ul class="agenda" data-testid="you-today">
                        @foreach (var o in mine)
                        {
                            var (a, b) = o.InTheRoom.Contains(me) ? TimeWindows.InRoom(o, me) : (o.Start, o.End);
                            bool on = PlanModel.Minutes(a) <= now && now < PlanModel.Minutes(b) && o.Happens;
                            string note = o.State switch
                            {
                                OccurrenceState.Cancelled => "cancelled",
                                OccurrenceState.Closed => "closed",
                                _ when o.AwayIds.Contains(me) => "you are away",
                                _ when o.Session.CoverIds.Contains(me) => "covering",
                                _ => on ? "now" : "",
                            };
                            <li><button type="button" class="agenda-row @(on ? "on" : "") @(o.Happens && !o.AwayIds.Contains(me) ? "" : "off")" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")"
                                        @onclick="() => OpenPlan(today, PersonFocus(person), o.Session.Id)">
                                <span class="agenda-time">@Cccc.Domain.Week.Hm(a)</span><b>@Looks.Title(t, o.Session)</b> <small>@Looks.Room(t, o.Session)@(note.Length > 0 ? " · " + note : "")</small>
                                @if (changedById.TryGetValue(o.Session.Id, out var c) && ChangeWords.What(t, c, today) is var words && words != "Cancelled")
                                {
                                    <span class="change-what" data-testid="you-changed">@words</span>
                                }
                            </button></li>
                        }
                        @foreach (var c in gone)
                        {
                            <li><div class="agenda-row off" style="--c:@(Looks.ColourOf(t, c.Was!) ?? "var(--rule)")" data-testid="you-gone">
                                <span class="agenda-time">@Cccc.Domain.Week.Hm(c.Was!.Start)</span><b>@Looks.Title(t, c.Was!)</b>
                                <span class="change-what">@ChangeWords.NoLongerTheirsWhat(t, c, today)</span>
                            </div></li>
                        }
                    </ul>
                }
                // What is new for them in their next two weeks, until they say they have seen it; what they did
                // themselves, through this sign-in or another linked to them, they have seen.
                var news = W.Project is { } project
                    ? NewsWords.Lines(News.For(t, read, me, today, new TimeOnly(local.Hour, local.Minute),
                        Seen.LoginsOf([me]).GetValueOrDefault(me, [W.Access.By]), Seen.Read(project.Id, me)))
                    : [];
                @if (news.Count > 0)
                {
                    <div class="news-head">
                        <h2 class="now-section">New for you</h2>
                        @if (news.Count > 1)
                        {
                            <button type="button" class="link" @onclick="() => GotIt(me, news.SelectMany(l => l.Changes), read)" data-testid="news-got-all">Got them all</button>
                        }
                    </div>
                    <ul class="news" data-testid="news">
                        @foreach (var line in news)
                        {
                            var s = line.Shown;
                            Guid? open = line.Kind == NewsKind.One && line.First.Now is not null ? s.Id : null;
                            <li class="news-line" @key="line.First.Id" data-testid="news-line">
                                <button type="button" class="change @(NewsWords.Off(line, me) ? "off" : "")" style="--c:@(Looks.ColourOf(t, s) ?? "var(--rule)")"
                                        @onclick="() => OpenPlan(s.Date, PersonFocus(person), open)" data-testid="news-open">
                                    <span class="change-what" data-testid="news-what">@NewsWords.What(t, line, me)</span>
                                    <span><b>@NewsWords.Title(t, line)</b> <small>@NewsWords.When(t, line)</small></span>
                                    <small class="change-by">@string.Join(" and ", line.By.Select(W.NameOf)), @W.Clock.Describe(line.At)</small>
                                </button>
                                <button type="button" class="btn quiet news-got" @onclick="() => GotIt(me, line.Changes, read)" data-testid="news-got">Got it</button>
                            </li>
                        }
                    </ul>
                }
            }
            @if (t.Sessions.Count == 0)
            {
                <StartHere />
            }
            else if (happening.Count == 0)
            {
                var next = t.Sessions.Where(s => s.Date > today && !s.Cancelled).OrderBy(s => s.Date).ThenBy(s => s.Start).FirstOrDefault();
                <div class="notice" data-testid="nothing-today">
                    <b>Nothing is on today.</b>
                    @if (next is not null)
                    {
                        <span> The next class is @Looks.Title(t, next), @Cccc.Domain.Week.ShortDate(next.Date) at @Cccc.Domain.Week.Hm(next.Start).</span>
                        <button type="button" class="link" @onclick="() => OpenPlan(next.Date, null, null)">Open that day</button>
                    }
                </div>
            }
            @* A departures board for the building: a row a space, grouped by kind, saying what is in it, until
               when, and what comes next. A board rather than tiles, so any number of spaces reads without gaps. *@
            @* A former space is on the board only on a day something is still in it. *@
            @{ var spaces = t.Rooms.Where(r => !r.IsFormer() || happening.Any(o => o.Session.RoomId == r.Id)).ToList(); }
            @if (spaces.Count > 0)
            {
            <h2 class="now-section">The building</h2>
            <div class="board" aria-label="Every space now">
                @{ var parts = spaces.OrderBy(r => r.Category is null).ThenBy(r => r.Category, NameOrder.Comparer).ThenBy(r => r.Name, NameOrder.Comparer).GroupBy(Sections.Of).ToList(); }
                @foreach (var part in parts)
                {
                    @if (parts.Count > 1)
                    {
                        <div class="board-section">@part.Key</div>
                    }
                    @foreach (var room in part)
                    {
                        var here = happening.Where(o => o.Session.RoomId == room.Id).ToList();
                        var current = here.FirstOrDefault(o => PlanModel.Minutes(o.Start) <= now && now < PlanModel.Minutes(o.End));
                        var next = here.FirstOrDefault(o => PlanModel.Minutes(o.Start) > now);
                        <button type="button" class="board-row @(current is null ? "free" : "busy")" style="--c:@room.Colour" @onclick="() => OpenPlan(today, RoomFocus(room), current?.Session.Id)" data-testid="space-row">
                            <span class="b-space">
                                <span class="b-name">@room.Name</span>
                                <span class="b-day" aria-hidden="true">
                                    @foreach (var o in here)
                                    {
                                        <i style="left:@Pct(PlanModel.Minutes(o.Start) - day0, day1 - day0)%; width:@Pct(PlanModel.Minutes(o.End) - PlanModel.Minutes(o.Start), day1 - day0)%; --k:@(Looks.ColourOf(t, o.Session) ?? "var(--border)")"></i>
                                    }
                                    @if (now >= day0 && now <= day1)
                                    {
                                        <i class="b-tick" style="left:@Pct(now - day0, day1 - day0)%"></i>
                                    }
                                </span>
                            </span>
                            <span class="b-now">
                                @if (current is not null)
                                {
                                    int s0 = PlanModel.Minutes(current.Start), e0 = PlanModel.Minutes(current.End);
                                    <span class="b-class" style="--k:@(Looks.ColourOf(t, current.Session) ?? "var(--ink)")">
                                        <b>@Looks.Title(t, current.Session)</b>
                                        <small>@Looks.Audience(t, current.Session)@(Looks.Initials(t, current) is { Length: > 0 } ini ? " · " + ini : "")</small>
                                        @if (current.NeedsCover)
                                        {
                                            <small class="b-cover"> · needs cover</small>
                                        }
                                    </span>
                                    <span class="space-progress" aria-hidden="true"><span style="width:@(Math.Clamp((now - s0) * 100 / Math.Max(1, e0 - s0), 0, 100))%"></span></span>
                                }
                                else
                                {
                                    <span class="b-free">Free</span>
                                }
                            </span>
                            <span class="b-until">@(current is not null ? "until " + Cccc.Domain.Week.Hm(current.End) : next is not null ? "until " + Cccc.Domain.Week.Hm(next.Start) : here.Count == 0 ? "all day" : "rest of the day")</span>
                            <span class="b-next">
                                @if (next is not null)
                                {
                                    <small>Next</small>@($" {Cccc.Domain.Week.Hm(next.Start)} {Looks.Title(t, next.Session)}")
                                }
                            </span>
                        </button>
                    }
                }
            </div>
            }
            @if (happening.Where(o => o.Session.RoomId is null).ToList() is { Count: > 0 } roomless)
            {
                <h2 class="now-section">Without a space</h2>
                <ul class="agenda">
                    @foreach (var o in roomless)
                    {
                        <li><button type="button" class="agenda-row" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")" @onclick="() => OpenPlan(today, null, o.Session.Id)">
                            <span class="agenda-time">@Looks.When(o.Session)</span><b>@Looks.Title(t, o.Session)</b> <small>@Looks.Audience(t, o.Session)</small></button></li>
                    }
                </ul>
            }
        </section>

        <aside class="now-needs" aria-label="Today needs" data-testid="today-needs">
            @if (requests.Count + offers.Count + spaceAsks.Count > 0)
            {
                <h2 class="now-section">Waiting for your answer</h2>
                <div class="now-asked" data-testid="waiting-answer">
                    @foreach (var r in requests)
                    {
                        int classes = Asking.TakesOff(t, r).Count;
                        <button type="button" class="need @(r.From <= today ? "warn" : "")" @onclick="() => Answer(r.Id, null)" data-testid="ask" data-kind="request">
                            <span class="need-kind">Can't come</span><b>@(t.Facilitators[r.FacilitatorId]?.Name)</b>
                            <small>@AskingWords.Days(r) · @(classes == 0 ? "none of their classes" : Looks.Count(classes, "class", "classes"))</small></button>
                    }
                    @foreach (var o in offers)
                    {
                        var s = t.Sessions[o.SessionId]!;
                        <button type="button" class="need" @onclick="() => Answer(null, o.Id)" data-testid="ask" data-kind="offer">
                            <span class="need-kind">Can cover</span><b>@(t.Facilitators[o.FacilitatorId]?.Name)</b>
                            <small>@Looks.Title(t, s), @Looks.WhenWithDay(s)</small></button>
                    }
                    @foreach (var a in spaceAsks)
                    {
                        int runsInto = Asking.WhatAYesClashesWith(t, a).Count;
                        <button type="button" class="need @(runsInto > 0 ? "warn" : "")" @onclick="() => AnswerSpace(a.Id)" data-testid="ask" data-kind="space">
                            <span class="need-kind">Space</span><b>@(t.Facilitators[a.FacilitatorId]?.Name)</b>
                            <small>@AskingWords.Title(t, a) · @(t.Rooms.Find(a.RoomId)?.Name ?? "a space that has gone") · @AskingWords.When(a)@(runsInto > 0 ? " · " + Looks.Count(runsInto, "clash", "clashes") : "")</small></button>
                    }
                </div>
            }
            <h2 class="now-section">Today needs</h2>
            @if (needs == 0)
            {
                <p class="calm" data-testid="all-clear">Nothing. No clashes, nobody to cover, no registers waiting for you.</p>
            }
            @foreach (var o in cover)
            {
                <button type="button" class="need warn" @onclick="() => OpenPlan(today, null, o.Session.Id)" data-testid="need"><span class="need-kind">Cover</span><b>@Looks.Title(t, o.Session)</b><small>@Looks.When(o.Session) · @Looks.Room(t, o.Session)</small></button>
            }
            @* A few registers are a line each, to press; a school's whole day of them is one line, opening
               Registers, where today's are cards to take, so cover and clashes stay in sight below. *@
            @if (registers.Count > 3)
            {
                var names = registers.Select(o => Looks.Title(t, o.Session)).Distinct().ToList();
                <a class="need" href="registers" data-testid="need-registers">
                    <span class="need-kind">Registers</span><b>@registers.Count from today not taken yet</b>
                    <small>@string.Join(", ", names.Take(3))@(names.Count > 3 ? $" and {names.Count - 3} more" : "")</small>
                </a>
            }
            else
            {
                @foreach (var o in registers)
                {
                    <button type="button" class="need" @onclick="() => OpenPlan(today, null, o.Session.Id)" data-testid="need"><span class="need-kind">Register</span><b>@Looks.Title(t, o.Session)</b><small>@Looks.When(o.Session) · @Looks.Audience(t, o.Session)</small></button>
                }
            }
            @if (earlier.Count > 0)
            {
                bool own = W.Access.FacilitatorId is not null;
                <a class="need" href="@(own ? "my-week" : $"reports/registers?from={Registers.EarlierFrom(today):yyyy-MM-dd}&to={Cccc.Domain.Week.MondayOf(today):yyyy-MM-dd}")" data-testid="need-earlier">
                    <span class="need-kind">Registers</span><b>@earlier.Count from earlier days not taken</b>
                    <small>@(own ? "Yours" : "The school's"), from the last eight weeks</small>
                </a>
            }
            @foreach (var c in clashes)
            {
                <button type="button" class="need warn" @onclick="() => OpenPlan(today, null, c.SessionIds[0])" data-testid="need"><span class="need-kind">Clash</span><span>@c.Description</span></button>
            }
            @if (changed.Count > 0)
            {
                <h2 class="now-section">Changed since @(since == today.AddDays(-1) ? "yesterday" : since.DayOfWeek.ToString())</h2>
                <div class="changes" data-testid="changes">
                    @foreach (var c in changed.Take(6))
                    {
                        var s = (c.Now ?? c.Was)!;
                        var room = Looks.Room(t, s);
                        <button type="button" class="change @(c.Deleted ? "gone" : c.Now!.Cancelled ? "off" : "")" style="--c:@(Looks.ColourOf(t, s) ?? "var(--rule)")"
                                disabled="@c.Deleted" @onclick="() => OpenPlan(s.Date, null, s.Id)" data-testid="change">
                            <span class="change-what">@ChangeWords.What(t, c, today)</span>
                            <span><b>@Looks.Title(t, s)</b> <small>@Looks.When(s)@(room.Length > 0 ? " · " + room : "")</small></span>
                            <small class="change-by">@string.Join(" and ", c.By.Select(W.NameOf)), @W.Clock.Describe(c.At)</small>
                        </button>
                    }
                    @if (changed.Count > 6)
                    {
                        <p class="muted">And @Looks.Count(changed.Count - 6, "more class", "more classes").</p>
                    }
                </div>
            }
            @if (events.Count > 0)
            {
                <h2 class="now-section">Today's events</h2>
                @foreach (var e in events.OrderBy(e => !e.Event.AllDay).ThenBy(e => e.Event.Start))
                {
                    <div class="need quiet"><span class="need-kind">@(e.Event.AllDay ? "All day" : Cccc.Domain.Week.Hm(e.Event.Start))</span><b>@e.Event.Title</b>@if (t.Rooms.Find(e.Event.RoomId) is { } r) { <small>@r.Name</small> }</div>
                }
            }
            <h2 class="now-section">Still to come</h2>
            @if (happening.Where(o => PlanModel.Minutes(o.Start) > now).Take(6).ToList() is { Count: > 0 } coming)
            {
                <ul class="agenda">
                    @foreach (var o in coming)
                    {
                        <li><button type="button" class="agenda-row" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")" @onclick="() => OpenPlan(today, null, o.Session.Id)">
                            <span class="agenda-time">@Cccc.Domain.Week.Hm(o.Start)</span><b>@Looks.Title(t, o.Session)</b> <small>@Looks.Room(t, o.Session)</small></button></li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">Nothing more today.</p>
            }
            <button type="button" class="btn" @onclick="() => OpenPlan(today, null, null)" data-testid="open-plan">The whole day ›</button>
        </aside>
    </div>
</div>

@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;

    private static Focus RoomFocus(Room r) => new("room", r.Id, r.Name);
    private static string Pct(int minutes, int span) => (Math.Clamp(minutes * 100.0 / Math.Max(1, span), 0, 100)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static Focus PersonFocus(Facilitator f) => new("facilitator", f.Id, f.Name);

    /// <summary>They have seen these: each is news again only once it changes after this.</summary>
    private void GotIt(Guid me, IEnumerable<ClassChange> items, IReadOnlyList<Change> read)
    {
        if (W.Project is { } p) Seen.GotIt(p.Id, me, items.ToList(), read);
    }

    private void AnswerSpace(Guid id) => D.Show<AnswerForm>(new Dictionary<string, object?> { [nameof(AnswerForm.SpaceAskId)] = id });

    private void Answer(Guid? request, Guid? offer) => D.Show<AnswerForm>(new Dictionary<string, object?>
    {
        [nameof(AnswerForm.RequestId)] = request,
        [nameof(AnswerForm.OfferId)] = offer,
    });

    private void OpenPlan(DateOnly day, Focus? focus, Guid? chosen)
    {
        V.Start(W.Today);
        V.Scale = Scale.Day;
        V.FocusOn(focus);
        if (focus is null) V.Lens = Lens.Spaces;
        V.GoTo(day);
        V.Chosen = chosen;
        Nav.NavigateTo("plan");
    }
}
