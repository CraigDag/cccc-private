@page "/reports/{Slug?}"
@using Cccc.Web.Features.Week
@using DomainWeek = Cccc.Domain.Week
@using Cccc.Web.Features.Sessions
@inject Dialogs D

<PageTitle>Reports · CCCC Scheduler</PageTitle>
@if (!W.Access.MayUseAdminTools)
{
    <div class="empty-state"><h1>Reports</h1><p>Reports are for administrators.</p></div>
}
else
{
    var t = W.T;
    var occ = ReportMath.Happening(t, _from, _to);
    var weeks = ReportMath.Mondays(_from, _to).ToList();
    <div class="page-head">
        <h1>Reports</h1>
        <div class="bar" style="margin:0">
            <label class="inline"><span>From the week of</span><input type="date" @bind="_from" /></label>
            <label class="inline"><span>to the week of</span><input type="date" @bind="_to" /></label>
            @foreach (var s in t.Semesters.OrderBy(s => s.FirstMonday))
            {
                <button type="button" class="btn quiet" @onclick="() => { _from = s.FirstMonday; _to = s.LastMonday; }">@s.Name</button>
            }
        </div>
    </div>
    <p class="muted">@weeks.Count week@(weeks.Count == 1 ? "" : "s"): @DomainWeek.ShortDate(DomainWeek.MondayOf(_from)) to @DomainWeek.ShortDate(DomainWeek.MondayOf(_to).AddDays(6)). Only classes that happen count: closed and cancelled ones do not.
        <span class="csv-links">Download as a spreadsheet:
            <a href="@Csv("hours")" download data-enhance-nav="false" data-testid="csv-hours">Hours</a> ·
            <a href="@Csv("attendance")" download data-enhance-nav="false" data-testid="csv-attendance">Attendance</a></span></p>
    <nav class="tabs">
        @foreach (var (slug, title) in Tabs)
        {
            <NavLink href="@("reports/" + slug)" class="@(Current == slug ? "active" : "")" Match="NavLinkMatch.All">@title</NavLink>
        }
    </nav>
    @switch (Current)
    {
        case "utilisation":
            <div class="section">
                <h2>By programme</h2>
                <HoursTable Rows="ReportMath.ByProgramme(t, occ)" />
            </div>
            <div class="section">
                <h2>By group</h2>
                <HoursTable Rows="ReportMath.ByGroup(t, occ)" />
                <p class="hint">A class for several groups counts in full for each, so this column can add up to more than the total. Whole-building classes are their own last row, never every group's.</p>
            </div>
            <div class="section">
                <h2>By area</h2>
                <HoursTable Rows="ReportMath.ByArea(t, occ, weeks.Count)" ShowTarget="true" />
            </div>
            break;
        case "attendance":
            var (classes, students) = ReportMath.Attendance(t, occ);
            <div class="section">
                <h2>By class</h2>
                <AttendanceTable Rows="classes" What="Class" />
            </div>
            <div class="section">
                <h2>By student</h2>
                <AttendanceTable Rows="students" What="Student" />
            </div>
            break;
        case "facilitators":
            <FacilitatorHours Weeks="weeks" />
            break;
        case "students":
            <StudentHours Weeks="weeks" />
            break;
        case "registers":
            var missing = Registers.MissingBetween(t, DomainWeek.MondayOf(_from), Min(DomainWeek.MondayOf(_to).AddDays(6), W.Today.AddDays(-1)), W.Today);
            <div class="section">
                <h2>Outstanding, by whose class it is</h2>
                <p class="hint">Counted off the assigned facilitators, so a week somebody covered is still a gap on whoever's class it is.</p>
                <div class="table-wrap"><table class="grid-table static">
                    <thead><tr><th>Facilitator</th><th class="num">Missing</th></tr></thead>
                    <tbody>
                        @foreach (var f in t.Facilitators.Select(f => (f, n: Registers.OutstandingFor(missing, f.Id))).Where(x => x.n > 0).OrderByDescending(x => x.n).ThenBy(x => x.f.Name, NameOrder.Comparer))
                        {
                            <tr><td><span class="spine" style="--c:@f.f.Colour"></span>@f.f.Name</td><td class="num">@f.n</td></tr>
                        }
                    </tbody>
                </table></div>
            </div>
            <div class="section">
                <h2>Every one (@missing.Count)</h2>
                <p class="hint">Press one to take it.</p>
                <div class="table-wrap"><table class="grid-table">
                    <thead><tr><th>Day</th><th>Time</th><th>Class</th><th>For</th><th>Facilitators</th></tr></thead>
                    <tbody>
                        @foreach (var o in missing)
                        {
                            <tr class="clickable" @onclick="() => OpenRegister(o.Session.Id)"><td>@DomainWeek.ShortDate(o.Date)</td><td>@Looks.When(o.Session)</td>
                                <td><button type="button" class="link" @onclick="() => OpenRegister(o.Session.Id)" @onclick:stopPropagation="true" data-testid="report-register-open">@Looks.Title(t, o.Session)</button></td>
                                <td>@Looks.Audience(t, o.Session)</td><td>@Looks.Names(t, o.Session.FacilitatorIds)</td></tr>
                        }
                    </tbody>
                </table></div>
            </div>
            break;
        default:
            var thisWeek = Occurrences.ForWeek(t, W.Today);
            var allMissing = Registers.MissingBetween(t, DomainWeek.MondayOf(_from), Min(DomainWeek.MondayOf(_to).AddDays(6), W.Today.AddDays(-1)), W.Today);
            var warnings = Clashes.ForWeek(t, W.Today);
            var clashes = warnings.Where(c => c.Kind != ClashKind.NeedsCover && !c.IsHardTraining).ToList();
            var hardDays = warnings.Where(c => c.IsHardTraining).ToList();
            var cover = Cover.StillNeeded(t, W.Today, W.Today);
            <div class="cards">
                <div class="card"><small>Classes this week</small><b>@thisWeek.Count(o => o.Happens)</b><small>@thisWeek.Count(o => !o.Happens) closed or cancelled</small></div>
                <div class="card"><small>Hours scheduled this week</small><b>@DomainWeek.Duration(thisWeek.Where(o => o.Happens).Aggregate(TimeSpan.Zero, (a, o) => a + o.Session.Length))</b></div>
                <div class="card @(clashes.Count > 0 ? "warn" : "")"><small>Clashes this week</small><b>@clashes.Count</b></div>
                <div class="card @(cover.Count > 0 ? "warn" : "")"><small>Needing cover this week</small><b>@cover.Count</b></div>
                <div class="card @(allMissing.Count > 0 ? "warn" : "")"><small>Registers missing</small><b>@allMissing.Count</b><small>In the weeks chosen</small></div>
                <div class="card"><small>Hours in these weeks</small><b>@DomainWeek.Duration(occ.Aggregate(TimeSpan.Zero, (a, o) => a + o.Session.Length))</b><small>@Looks.Count(occ.Count, "class", "classes")</small></div>
                @if (t.Settings.WeeklyScheduledTarget is { } goal)
                {
                    // Advice, so not amber: a part-time programme can be short of the school's one target every week.
                    var shortNow = t.Students.Count(s => Hours.ForStudent(t, W.Today, thisWeek, s.Id).Short);
                    <div class="card"><small>Short of the @DomainWeek.Duration(goal) target</small><b data-testid="students-short">@shortNow</b><small>@(shortNow == 1 ? "student" : "students") this week · <a href="reports/students">Student hours</a></small></div>
                }
                @if (HardTraining.HasLimits(t))
                {
                    // Advice about the shape of a group's day, like the target: so not amber either.
                    <div class="card" title="@string.Join("\n", hardDays.Select(c => c.Description))"><small>Hard training past the limits</small><b data-testid="hard-past-limits">@hardDays.Count</b><small>this week · Plan ▸ Groups shows each group's day</small></div>
                }
                <div class="card"><small>People</small><b>@t.Students.Count</b><small>@(t.Students.Count == 1 ? "student" : "students") · @Looks.Count(t.Facilitators.Count(f => !f.IsGuest && !f.IsFormer()), "facilitator") · @Looks.Count(t.Groups.Count, "group")</small></div>
            </div>
            break;
    }
}
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    [Parameter] public string? Slug { get; set; }
    // Weeks given in the address (Now's "registers from earlier days" sends its own), as yyyy-MM-dd.
    [SupplyParameterFromQuery(Name = "from")] public string? FromWeek { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToWeek { get; set; }

    // The timetable this tab shows, by id: a tab looking at next year downloads next year's.
    private string Csv(string kind) =>
        $"reports/csv/{kind}?project={W.Project?.Id}&from={DomainWeek.MondayOf(_from):yyyy-MM-dd}&to={DomainWeek.MondayOf(_to).AddDays(6):yyyy-MM-dd}";
    private DateOnly _from, _to;

    private static readonly (string, string)[] Tabs =
        [("overview", "Overview"), ("utilisation", "Utilisation"), ("attendance", "Attendance"), ("facilitators", "Facilitator hours"), ("students", "Student hours"), ("registers", "Registers outstanding")];

    private string Current => Tabs.Any(x => x.Item1 == Slug) ? Slug! : "overview";

    protected override void OnInitialized()
    {
        var sem = W.T.SemesterNear(W.Today);
        _to = DomainWeek.MondayOf(W.Today);
        _from = sem is not null && sem.FirstMonday <= _to ? sem.FirstMonday : _to.AddDays(-7 * 7);
        if (Day(FromWeek) is { } f && Day(ToWeek) is { } u && f <= u) (_from, _to) = (f, u);
    }

    private static DateOnly? Day(string? s) =>
        DateOnly.TryParseExact(s, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    private void OpenRegister(Guid id) => D.Show<RegisterForm>(new Dictionary<string, object?> { [nameof(RegisterForm.SessionId)] = id });

    private static DateOnly Min(DateOnly a, DateOnly b) => a < b ? a : b;
}
