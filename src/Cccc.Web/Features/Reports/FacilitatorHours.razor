@using DomainWeek = Cccc.Domain.Week
@inject Dialogs D
@{
    var t = W.T;
    var byWeek = Weeks.ToDictionary(m => m, m => Hours.ByFacilitator(t, Occurrences.HappeningInWeek(t, m)));
    var people = t.Facilitators.OrderBy(f => f.IsGuest).ThenBy(f => f.Name, NameOrder.Comparer).ToList();
    var ruleNames = t.TimeRules.OrderBy(r => r.DisplayName, NameOrder.Comparer).ToList();
}
<div class="seg" role="group" style="margin-bottom:12px">
    <button type="button" class="@(_breakdown ? "" : "on")" @onclick="() => _breakdown = false">Week by week</button>
    <button type="button" class="@(_breakdown ? "on" : "")" @onclick="() => _breakdown = true">Breakdown</button>
</div>
@if (!_breakdown)
{
    <div class="table-wrap">
        <table class="grid-table static" data-testid="hours-by-week">
            <thead>
                <tr><th>Facilitator</th>@foreach (var m in Weeks) { <th class="num">Wk @DomainWeek.IsoNumber(m)</th> }<th class="num">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var f in people)
                {
                    var total = TimeSpan.Zero;
                    <tr>
                        <td><span class="spine" style="--c:@f.Colour"></span>@f.Name@(f.IsGuest ? " (guest)" : "")</td>
                        @foreach (var m in Weeks)
                        {
                            var h = byWeek[m].GetValueOrDefault(f.Id)?.Total ?? TimeSpan.Zero;
                            total += h;
                            bool over = f.MaxWeeklyHours is { } max && h > max;
                            <td class="num" style="@(over ? "color:var(--warning);font-weight:700" : "")" title="@(over ? "Over their limit of " + DomainWeek.Duration(f.MaxWeeklyHours!.Value) : "")">
                                @if (h == TimeSpan.Zero)
                                {
                                    <span>–</span>
                                }
                                else
                                {
                                    <button type="button" class="link" title="@("What makes up " + f.Name + "’s " + DomainWeek.Duration(h) + " in week " + DomainWeek.IsoNumber(m))" @onclick="() => Explain(f.Id, [m])" data-testid="hours-cell">@DomainWeek.Duration(h)</button>
                                }
                            </td>
                        }
                        <td class="num"><button type="button" class="link" title="@("Every line of " + f.Name + "’s hours in these weeks")" @onclick="() => Explain(f.Id, Weeks)" data-testid="hours-total"><b>@DomainWeek.Duration(total)</b></button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="hint">Teaching plus every time rule. Cover counts for whoever was in the room; a class still waiting for cover counts for nobody. Over a limit is shown, never refused. Press a figure to see every class and time rule that makes it up.</p>
}
else
{
    <div class="table-wrap">
        <table class="grid-table static" data-testid="hours-breakdown">
            <thead>
                <tr><th>Facilitator</th><th class="num">Teaching</th>@foreach (var r in ruleNames) { <th class="num">@r.DisplayName</th> }<th class="num">Total</th><th class="num">Limit over these weeks</th></tr>
            </thead>
            <tbody>
                @foreach (var f in people)
                {
                    var splits = Weeks.Select(m => byWeek[m].GetValueOrDefault(f.Id) ?? HoursSplit.None).ToList();
                    var teaching = splits.Aggregate(TimeSpan.Zero, (a, s) => a + s.Teaching);
                    var total = splits.Aggregate(TimeSpan.Zero, (a, s) => a + s.Total);
                    <tr>
                        <td><span class="spine" style="--c:@f.Colour"></span>@f.Name</td>
                        <td class="num">@DomainWeek.Duration(teaching)</td>
                        @foreach (var r in ruleNames)
                        {
                            var x = splits.SelectMany(s => s.Rules).Where(rt => rt.RuleId == r.Id).Aggregate(TimeSpan.Zero, (a, rt) => a + rt.Time);
                            <td class="num">@(x == TimeSpan.Zero ? "–" : DomainWeek.Duration(x))</td>
                        }
                        <td class="num"><button type="button" class="link" @onclick="() => Explain(f.Id, Weeks)" data-testid="breakdown-total"><b>@DomainWeek.Duration(total)</b></button></td>
                        <td class="num">@(f.MaxWeeklyHours is { } max ? DomainWeek.Duration(max * Weeks.Count) : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<DateOnly> Weeks { get; set; } = [];
    private bool _breakdown;

    private void Explain(Guid facilitatorId, IReadOnlyList<DateOnly> weeks) =>
        D.Show<HoursLines>(new Dictionary<string, object?> { [nameof(HoursLines.FacilitatorId)] = facilitatorId, [nameof(HoursLines.Weeks)] = weeks });
}
