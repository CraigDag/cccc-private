@inject Dialogs D
@inject IJSRuntime JS
<section class="dialog @Class" role="dialog" aria-modal="true" aria-labelledby="dialog-title" data-testid="dialog" @ref="_panel">
    <form class="dialog-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" autocomplete="off">
        <header class="dialog-head">
            <h2 id="dialog-title">@Title</h2>
            <button type="button" class="dialog-x" aria-label="Close" data-close @onclick="D.Close">×</button>
        </header>
        <div class="dialog-body">@ChildContent</div>
        <footer class="dialog-foot">
            @Extra
            <span class="grow"></span>
            @if (OnOk.HasDelegate)
            {
                <button type="submit" class="btn primary" disabled="@(!OkEnabled)" data-testid="dialog-ok">@OkLabel</button>
                <button type="button" class="btn" @onclick="D.Close" data-testid="dialog-cancel">@DismissLabel</button>
            }
            else
            {
                <button type="button" class="btn" @onclick="D.Close" data-testid="dialog-close">Close</button>
            }
        </footer>
    </form>
</section>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Extra { get; set; }
    [Parameter] public EventCallback OnOk { get; set; }
    [Parameter] public string OkLabel { get; set; } = "OK";
    [Parameter] public bool OkEnabled { get; set; } = true;
    [Parameter] public string DismissLabel { get; set; } = "Cancel";
    private ElementReference _panel;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) await JS.InvokeVoidAsync("ccccShell.trap", _panel);
    }

    private async Task SubmitAsync()
    {
        if (OnOk.HasDelegate && OkEnabled) await OnOk.InvokeAsync();
    }
}
