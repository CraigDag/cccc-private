@page "/my-week"
@using Cccc.Web.Features.Week
@using Cccc.Web.Features.Sessions
@using Cccc.Web.Features.Print
@using Cccc.Web.Features.Ask
@inject Dialogs D
@inject PrintRequests Prints

<PageTitle>My week · CCCC Scheduler</PageTitle>
@if (Me is null)
{
    <div class="empty-state">
        <h1>My week</h1>
        <p>Your account is not linked to a facilitator, so there is no week of yours to show. An administrator links accounts in Administration ▸ Accounts.</p>
    </div>
}
else
{
    var t = W.T;
    var m = WeekModel.Build(t, _view, W.Access, W.Today, s => s.FacilitatorIds.Contains(Me.Id) || s.CoverIds.Contains(Me.Id), Me.Id);
    var split = Hours.For(t, Occurrences.HappeningInWeek(t, _view.Monday), Me.Id);
    // Counted from today, whichever week is on screen, and only this person's: an administrator's power to
    // take every register is not a list of every register on My week.
    var missing = Registers.StillToTake(t, Me.Id, W.Today);
    <WeekNav Monday="_view.Monday" Today="W.Today" Title="@("My week, " + Me.Name)" Go="d => _view.GoTo(d)">
        <a class="btn" href="@Prints.Link("mine", _view, W, Me.Id)" target="_blank" rel="noopener">Print my week</a>
        <a class="btn" href="@PhoneCalendar.Link(W, Me.Id, _view.Monday)" download title="@PhoneCalendar.Note" data-testid="phone-calendar">Add to phone calendar</a>
        @if (W.Access.MayEditSomething)
        {
            <button type="button" class="btn" @onclick="CantCome" data-testid="cant-come">Can't come…</button>
        }
    </WeekNav>
    <FollowingNotice OnlyWhenBehind="true" />
    <div class="cards">
        <div class="card @(Me.MaxWeeklyHours is { } max && split.Total > max ? "warn" : "")">
            <small>Hours this week</small><b>@Cccc.Domain.Week.Duration(split.Total)</b>
            <small>Teaching @Cccc.Domain.Week.Duration(split.Teaching)@string.Concat(split.Rules.Select(r => $" · {r.Name} {Cccc.Domain.Week.Duration(r.Time)}"))@(Me.MaxWeeklyHours is { } lim ? $" · limit {Cccc.Domain.Week.Duration(lim)}" : "")</small>
            <small><button type="button" class="link" @onclick="() => ExplainHours(Me.Id)" data-testid="my-hours-lines">How it adds up</button></small>
        </div>
        <div class="card @(missing.Count > 0 ? "warn" : "")">
            <small>Registers to take</small><b data-testid="still-to-take-count">@missing.Count</b>
            <small>From the last eight weeks@(W.Access.Following ? ", taken in the current app" : "")</small>
        </div>
    </div>
    @if (missing.Count > 0)
    {
        <div class="section">
            <h2>Registers to take</h2>
            <ul class="pick-list" data-testid="still-to-take">
                @foreach (var o in missing)
                {
                    <li><button type="button" class="pick" @onclick="() => Take(o.Session.Id)"><b>@Looks.Title(t, o.Session)</b> <small>@Looks.WhenWithDay(o.Session) · @Looks.Audience(t, o.Session)</small></button></li>
                }
            </ul>
        </div>
    }
    <MyAsking Me="Me.Id" />
    <DayList M="m" W="W" OnOpen="OpenSession" OnOpenEvent="OpenEvent" />
    @* Said on the page as well as on the button: a phone shows no tooltip. *@
    <p class="muted" data-testid="phone-calendar-note"><i>Add to phone calendar</i> downloads this semester as a calendar file to open on your phone. It does not update itself: download it again after the timetable changes, and open it over the last one.</p>
}
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    private readonly WeekView _view = new() { ShowGuests = true };

    private Facilitator? Me => W.Access.FacilitatorId is { } id ? W.T.Facilitators[id] : null;

    protected override void OnInitialized()
    {
        _view.Start(W.Today, null);
        _view.Moved += () => _ = InvokeAsync(StateHasChanged);
    }

    private void OpenSession(Guid id) => D.Show<SessionForm>(new Dictionary<string, object?> { [nameof(SessionForm.SessionId)] = id });

    private void OpenEvent(Guid id) => D.Show<Cccc.Web.Features.Events.EventForm>(new Dictionary<string, object?> { [nameof(Cccc.Web.Features.Events.EventForm.EventId)] = id });

    private void ExplainHours(Guid id) => D.Show<Cccc.Web.Features.Reports.HoursLines>(new Dictionary<string, object?>
    {
        [nameof(Cccc.Web.Features.Reports.HoursLines.FacilitatorId)] = id,
        [nameof(Cccc.Web.Features.Reports.HoursLines.Weeks)] = new[] { _view.Monday },
    });

    private void Take(Guid id) => D.Show<RegisterForm>(new Dictionary<string, object?> { [nameof(RegisterForm.SessionId)] = id });

    private void CantCome() => D.Show<CantComeForm>();
}
