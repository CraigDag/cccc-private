@page "/cover"
@implements IDisposable
@inject WeekView V
@inject Dialogs D

<PageTitle>Cover · CCCC Scheduler</PageTitle>
@{
    var t = W.T;
    var week = Occurrences.ForWeek(t, V.Monday);
    var needed = week.Where(o => o.NeedsCover).ToList();
    var covered = week.Where(o => o.Covered).ToList();
    bool ended = DomainWeek.HasEnded(V.Monday, W.Today);
    var sunday = V.Monday.AddDays(6);
    // The school's days, and a weekend day only when something is on it.
    var days = Enumerable.Range(0, 7).Select(i => V.Monday.AddDays(i))
        .Where(d => d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday) || week.Any(o => o.Date == d)).ToList();
    var away = t.Absences.Where(a => a.Person == AbsentPerson.Facilitator && a.From <= sunday && a.To >= V.Monday)
        .GroupBy(a => a.PersonId)
        .Select(g => (Id: g.Key, Name: t.Facilitators[g.Key]?.Name ?? "Somebody removed", Colour: t.Facilitators[g.Key]?.Colour, Absences: g.OrderBy(a => a.From).ToList()))
        .OrderBy(x => x.Name, NameOrder.Comparer).ToList();
}
<WeekNav Monday="V.Monday" Today="W.Today" Title="Cover" Go="d => V.GoTo(d)" />
<p class="hint">A class needs cover when every facilitator on it is away. Cover stands in for whoever is away and leaves a co-teacher on it. Press a name to give them the class; Undo takes it back.</p>

<h2 class="now-section">Needs cover · @needed.Count</h2>
@if (needed.Count == 0)
{
    <p class="calm" data-testid="cover-none">Nothing this week needs cover.</p>
}
<div class="cover-cards">
    @foreach (var o in needed)
    {
        <article class="cover-card" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")" data-testid="cover-gap" @key="o.Session.Id">
            <div class="cc-when">@Looks.DayHeading(o.Date) · @Looks.When(o.Session)</div>
            <button type="button" class="cc-title" @onclick="() => Open(o.Session.Id)" disabled="@(!W.Access.MayEdit)">@Looks.Title(t, o.Session)</button>
            <div class="cc-facts">@Looks.Audience(t, o.Session)@(Looks.Room(t, o.Session) is { Length: > 0 } r ? " · " + r : "") · away: <b>@Looks.Names(t, o.AwayIds)</b></div>
            @if (ended)
            {
                <div class="cc-past">This week has ended, so the class does not change.</div>
            }
            else if (o.Date < W.Today)
            {
                <div class="cc-past">Already past: giving it to somebody now records who stood in.</div>
            }
            <CoverPicks Gap="o" />
        </article>
    }
</div>

<h2 class="now-section">Covered · @covered.Count</h2>
@if (covered.Count == 0)
{
    <p class="muted">Nobody is covering anything this week.</p>
}
else
{
    <ul class="list covered-list">
        @foreach (var o in covered)
        {
            <li class="list-row covered-row" data-testid="covered-row" @key="o.Session.Id">
                <span class="spine" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")"></span>
                <span class="name">@Looks.Title(t, o.Session) <small>@Looks.WhenWithDay(o.Session)</small>
                    <span class="cr-who">@Looks.Names(t, o.Session.CoverIds) for @(Looks.Names(t, o.AwayIds) is { Length: > 0 } a ? a : "nobody away now")@(o.Session.CoverNote is { Length: > 0 } n ? " · " + n : "")</span>
                </span>
                @if (W.Access.MayEdit && !ended)
                {
                    <button type="button" class="btn" @onclick="() => Open(o.Session.Id)">Change…</button>
                    <button type="button" class="btn quiet" @onclick="() => TakeOff(o.Session.Id)" data-testid="cover-take-off">Take it off</button>
                }
            </li>
        }
    </ul>
}

<h2 class="now-section">Away this week</h2>
@if (away.Count == 0)
{
    <p class="muted">Nobody is recorded as away.</p>
}
else
{
    <div class="away-grid" style="--days:@days.Count" data-testid="away-grid">
        <span class="ag-corner"></span>
        @foreach (var d in days)
        {
            <span class="ag-day @(d == W.Today ? "today" : "")">@d.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture) <b>@d.Day</b></span>
        }
        @foreach (var p in away)
        {
            <span class="ag-name"><span class="spine" style="--c:@(p.Colour ?? "var(--border)")"></span>@p.Name</span>
            @foreach (var d in days)
            {
                var a = p.Absences.FirstOrDefault(x => x.CoversDate(d));
                var part = a is { StartTime: { } s, EndTime: { } e } && e > s ? $"{DomainWeek.Hm(s)}–{DomainWeek.Hm(e)}" : null;
                <span class="ag-cell @(a is null ? "" : part is null ? "off" : "part")" title="@(a is null ? "" : part is null ? "Away all day" : "Away " + part)">@part</span>
            }
        }
    </div>
}
@if (W.Access.MayUseAdminTools)
{
    <p class="cover-foot"><a href="data/absences">Record an absence in People &amp; places ▸ Absences</a></p>
}
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;

    protected override void OnInitialized()
    {
        V.Start(W.Today, null);
        V.Moved += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void Open(Guid id) => D.Show<CoverForm>(new Dictionary<string, object?> { [nameof(CoverForm.SessionId)] = id });

    private void TakeOff(Guid id) => W.Commit(t => Edits.SetCover(t, id, [], null));

    public void Dispose() => V.Moved -= Refresh;
}
