@page "/registers"
@implements IDisposable
@inject WeekView V
@inject Dialogs D

<PageTitle>Registers · CCCC Scheduler</PageTitle>
@{
    var t = W.T;
    var rows = Occurrences.ForWeek(t, V.Monday)
        .Where(o => Roster.For(t, o.Session).Count > 0 || t.Registers.Contains(o.Session.Id))
        .Where(o => !_mine || Registers.MayChange(W.Access.Registers, o.Session))
        .ToList();
}
<WeekNav Monday="V.Monday" Today="W.Today" Title="Registers" Go="d => V.GoTo(d)">
    @if (W.Access.FacilitatorId is not null && W.Access.MayTakeEveryRegister)
    {
        <label class="check"><input type="checkbox" @bind="_mine" /> Only the ones I can take</label>
    }
</WeekNav>
@if (Cccc.Domain.Week.MondayOf(W.Today) == V.Monday && rows.Where(o => o.Date == W.Today && o.Happens).ToList() is { Count: > 0 } today)
{
    var local = W.Clock.Local(W.Clock.Now);
    var now = new TimeOnly(local.Hour, local.Minute);
    <h2 class="now-section">Today</h2>
    <div class="reg-cards" data-testid="registers-today">
        @foreach (var o in today)
        {
            var r = t.Registers[o.Session.Id];
            bool mine = Registers.MayChange(W.Access.Registers, o.Session);
            string state = r is not null ? "taken" : o.Start <= now && now < o.End ? "now" : o.End <= now ? "due" : "later";
            <button type="button" class="reg-card @state" style="--c:@(Looks.ColourOf(t, o.Session) ?? "var(--rule)")" @onclick="() => Open(o.Session.Id)" data-testid="register-card">
                <span class="reg-time">@Looks.When(o.Session)</span>
                <b>@Looks.Title(t, o.Session)</b>
                <small>@Looks.Audience(t, o.Session)@(Looks.Room(t, o.Session) is { Length: > 0 } room ? " · " + room : "")</small>
                <span class="reg-state">
                    @if (r is not null)
                    {
                        var (p, e, a) = r.Tally();
                        <span>✓ Taken · @p present@(a > 0 ? $" · {a} absent" : "")</span>
                    }
                    else if (!mine)
                    {
                        <span>Not yet taken</span>
                    }
                    else
                    {
                        <span class="reg-go">@(state == "later" ? "Take it later" : "Take the register ›")</span>
                    }
                </span>
            </button>
        }
    </div>
    <h2 class="now-section">The whole week</h2>
}
<p class="hint">Everybody can read every register. A facilitator takes the register for a class they were in the room for; administrators can take them all. A register with nobody ticked is not missing: it says nobody came.</p>
@if (rows.Count == 0)
{
    <p class="week-empty">No classes with students on them this week@(_mine ? " that you can take" : "").</p>
}
else
{
    <div class="table-wrap">
        <table class="grid-table reg-table" data-testid="registers-table">
            <thead><tr><th>Day</th><th>Time</th><th>Class</th><th>For</th><th>In the room</th><th>Register</th></tr></thead>
            <tbody>
                @foreach (var o in rows)
                {
                    var state = Registers.StateOf(t, o, W.Today);
                    var r = t.Registers[o.Session.Id];
                    <tr @onclick="() => Open(o.Session.Id)" class="@(o.Happens ? "clickable" : "off")" data-testid="register-line">
                        <td class="rt-day">@Looks.DayHeading(o.Date)</td>
                        <td class="rt-time nowrap">@Looks.When(o.Session)</td>
                        @* A real button, so the register opens from the keyboard too; the whole row still answers a click. *@
                        <td class="rt-title"><button type="button" class="link" @onclick="() => Open(o.Session.Id)" @onclick:stopPropagation="true" data-testid="register-open">@Looks.Title(t, o.Session)</button></td>
                        <td class="rt-for">@Looks.Audience(t, o.Session)</td>
                        <td class="rt-room">@Looks.Names(t, o.InTheRoom)</td>
                        <td class="rt-state">
                            @switch (state)
                            {
                                case RegisterState.Taken when r is not null:
                                    var (p, e, a) = r.Tally();
                                    <span>@p present · @e excused · @a absent</span>
                                    break;
                                case RegisterState.Missing:
                                    <span class="form-error">Missing</span>
                                    break;
                                case RegisterState.ToCome:
                                    <span class="muted">To come</span>
                                    break;
                                default:
                                    <span class="muted">@(state == RegisterState.Closed ? "Closed" : "No register")</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    private bool _mine;

    protected override void OnInitialized()
    {
        V.Start(W.Today, null);
        _mine = !W.Access.MayTakeEveryRegister && W.Access.FacilitatorId is not null;
        V.Moved += Refresh;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void Open(Guid id) => D.Show<RegisterForm>(new Dictionary<string, object?> { [nameof(RegisterForm.SessionId)] = id });

    public void Dispose() => V.Moved -= Refresh;
}
