@* The heading shared by the pages that are about one week: the page's name, then ‹ the week › and This week. *@
<div class="week-head" data-testid="week-head">
    <div class="week-title">
        <h1>@Title</h1>
        <div class="week-nav">
            <button type="button" class="btn icon quiet" @onclick="() => Go.InvokeAsync(Monday.AddDays(-7))" aria-label="Previous week">‹</button>
            <span class="week-label" data-testid="week-number">Week @Cccc.Domain.Week.IsoNumber(Monday) <small>@Cccc.Domain.Week.Range(Monday)</small></span>
            <button type="button" class="btn icon quiet" @onclick="() => Go.InvokeAsync(Monday.AddDays(7))" aria-label="Next week">›</button>
            <input type="date" class="week-date" value="@Monday.ToString("yyyy-MM-dd")" @onchange="OnDate" aria-label="Week of" />
            @if (Cccc.Domain.Week.MondayOf(Today) != Monday)
            {
                <button type="button" class="btn quiet" @onclick="() => Go.InvokeAsync(Today)">This week</button>
            }
        </div>
    </div>
    @ChildContent
</div>
@code {
    [Parameter, EditorRequired] public DateOnly Monday { get; set; }
    [Parameter, EditorRequired] public DateOnly Today { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback<DateOnly> Go { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OnDate(ChangeEventArgs e) =>
        DateOnly.TryParse(e.Value?.ToString(), out var d) ? Go.InvokeAsync(d) : Task.CompletedTask;
}
