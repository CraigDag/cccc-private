@inject IJSRuntime JS
@implements IDisposable
@{
    var t = W.T;
    int hours = (M.FrameEnd - M.FrameStart) / 60;
    int height = hours * HourPx;
}
<div class="wk" data-testid="week-grid">
    <div class="wk-heads" style="--days:@M.Days.Count">
        <div class="wk-gutter-head"></div>
        @foreach (var d in M.Days)
        {
            var closed = Occurrences.ClosureFor(t, d, null);
            <div class="wk-head @(d == W.Today ? "today" : "")" data-testid="day-head">
                <div class="wk-day">@Looks.DayHeading(d)</div>
                @if (closed is not null)
                {
                    <div class="wk-closed" title="The whole building is closed">Closed · @closed.Name</div>
                }
                @foreach (var e in M.Events.Where(e => e.Covers(d)).OrderBy(e => !e.Event.AllDay).ThenBy(e => e.Event.Start))
                {
                    <button type="button" class="wk-event @(e.Event.AllDay ? "allday" : "")" @onclick="() => OpenEvent.InvokeAsync(e.Event.Id)" data-testid="event-chip"
                            title="@(e.Event.Audience == EventAudience.Administrators ? "Administrators only" : "")">
                        @if (!e.Event.AllDay)
                        {
                            <span class="wk-event-time">@Cccc.Domain.Week.Hm(e.Event.Start)</span>
                        }
                        @e.Event.Title
                    </button>
                }
            </div>
        }
    </div>
    <div class="wk-body" @ref="_root" data-start="@M.FrameStart" data-end="@M.FrameEnd" data-hour="@HourPx" data-edit="@(Editable ? "1" : "0")"
         style="--days:@M.Days.Count; --hour:@(HourPx)px">
        <div class="wk-gutter" style="height:@(height)px">
            @for (int h = 0; h < hours; h++)
            {
                <div class="wk-hour" style="top:@(h * HourPx)px">@($"{(M.FrameStart / 60 + h):00}:00")</div>
            }
        </div>
        @for (int i = 0; i < M.Days.Count; i++)
        {
            var day = M.Days[i];
            <div class="wk-col @(day == W.Today ? "today" : "") @(Occurrences.ClosureFor(t, day, null) is not null ? "closed" : "")" data-day="@i" style="height:@(height)px">
                @if (day == W.Today && NowMinutes is { } now && now >= M.FrameStart && now <= M.FrameEnd)
                {
                    <div class="wk-now" style="top:@Px(now - M.FrameStart)px"></div>
                }
                @{ var seen = new HashSet<Guid>(); }
                @foreach (var p in M.Placed.Where(p => p.Date == day))
                {
                    var o = M.Find(p.Id);
                    if (o is null) continue;
                    var s = o.Session;
                    bool first = seen.Add(p.Id);
                    var colour = Looks.ColourOf(t, s);
                    bool movable = Editable && M.PartOf is null && !M.Locked;
                    double pad = p.Width <= 0 ? 0 : Math.Max(0, (p.ClearFrom - p.Left) / p.Width * 100);
                    <div class="block @Classes(o, p)" data-id="@s.Id" data-start="@p.StartMinutes" data-end="@p.EndMinutes" data-move="@(movable ? "1" : "0")"
                         data-testid="block" data-title="@Looks.Title(t, s)" tabindex="0" role="button" aria-label="@(Looks.Title(t, s) + ", " + Looks.WhenWithDay(s))"
                         style="top:@Px(p.StartMinutes - M.FrameStart)px; height:@Px(Math.Max(15, p.EndMinutes - p.StartMinutes))px; left:calc(@Pct(p.Left)% + 1px); width:calc(@Pct(p.Width)% - 3px); @(colour is null ? "" : $"--c:{colour};")">
                        @if (first)
                        {
                            <div class="block-in" style="@(pad > 0 ? $"padding-left:calc({Pct(pad / 100)}% + 6px)" : "")">
                                <div class="block-title">@Looks.Title(t, s)</div>
                                <div class="block-meta">@(M.PartOf is { } f ? Describe(o, f) : Looks.When(s))@(Looks.Room(t, s) is { Length: > 0 } r ? " · " + r : "")</div>
                                @if (Looks.Initials(t, o) is { Length: > 0 } ini)
                                {
                                    <div class="block-meta">@ini</div>
                                }
                                @if (Tag(o) is { } tag)
                                {
                                    <span class="block-tag">@tag</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    public const int HourPx = 56;
    [Parameter, EditorRequired] public WeekModel M { get; set; } = default!;
    [Parameter, EditorRequired] public Workspace W { get; set; } = default!;
    [Parameter, EditorRequired] public WeekGestures Gestures { get; set; } = default!;
    [Parameter] public IReadOnlySet<Guid> Chosen { get; set; } = new HashSet<Guid>();
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<Guid> OpenEvent { get; set; }
    private ElementReference _root;
    private DotNetObjectReference<WeekGestures>? _ref;

    private int? NowMinutes
    {
        get
        {
            var local = W.Clock.Local(W.Clock.Now);
            return DateOnly.FromDateTime(local.DateTime) == W.Today ? local.Hour * 60 + local.Minute : null;
        }
    }

    private static string Px(int minutes) => (minutes / 60.0 * HourPx).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Pct(double f) => (f * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private string Classes(Occurrence o, Placed p)
    {
        var c = new List<string>();
        if (Looks.ColourOf(W.T, o.Session) is null) c.Add("neutral");
        if (p.Beneath) c.Add("beneath");
        if (o.NeedsCover) c.Add("cover");
        if (o.State == OccurrenceState.Cancelled) c.Add("cancelled");
        if (o.State == OccurrenceState.Closed) c.Add("closed");
        if (M.Ringed.Contains(o.Session.Id)) c.Add("clash");
        if (o.Session.Provisional) c.Add("provisional");
        if (Chosen.Contains(o.Session.Id)) c.Add("chosen");
        if (p.EndMinutes - p.StartMinutes <= 45) c.Add("short");
        return string.Join(' ', c);
    }

    private static string? Tag(Occurrence o) => o.State switch
    {
        OccurrenceState.NeedsCover => "COVER",
        OccurrenceState.Cancelled => "CANCELLED",
        OccurrenceState.Closed => "CLOSED",
        _ when o.Session.MovedFrom is not null => "MOVED",
        _ when o.Session.Provisional => "PROVISIONAL",
        _ => null,
    };

    private static string Describe(Occurrence o, Guid f)
    {
        var (a, b) = TimeWindows.InRoom(o, f);
        return $"{Cccc.Domain.Week.Hm(a)}–{Cccc.Domain.Week.Hm(b)}" + (a != o.Start || b != o.End ? $" (class {Looks.When(o.Session)})" : "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ref is not null && ReferenceEquals(_ref.Value, Gestures) && !firstRender) return;
        _ref?.Dispose();
        _ref = DotNetObjectReference.Create(Gestures);
        await JS.InvokeVoidAsync("ccccWeek.attach", _root, _ref);
    }

    public void Dispose() => _ref?.Dispose();
}
