<div class="table-wrap">
<table class="grid-table" data-testid="week-list">
    <thead>
        <tr>
            @foreach (var (key, label) in Columns)
            {
                <th aria-sort="@(_sort == key ? (_desc ? "descending" : "ascending") : "none")">
                    <button type="button" @onclick="() => SortBy(key)">@label @(_sort == key ? (_desc ? "▾" : "▴") : "")</button>
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Sorted())
        {
            var s = o.Session;
            var colour = Looks.ColourOf(W.T, s);
            <tr class="@(Chosen.Contains(s.Id) ? "chosen" : "") @(o.Happens ? "" : "off")" @onclick="() => OnOpen.InvokeAsync(s.Id)" data-testid="list-row">
                <td>@Looks.DayHeading(s.Date)</td>
                <td class="nowrap">@Looks.When(s)</td>
                <td><span class="spine" style="@(colour is null ? "" : $"--c:{colour}")"></span>@Looks.Title(W.T, s)</td>
                <td>@Looks.Audience(W.T, s)</td>
                <td>@Looks.Room(W.T, s)</td>
                <td>@Looks.Names(W.T, o.InTheRoom)</td>
                <td>@Looks.StateWord(o)@(M.Ringed.Contains(s.Id) ? (Looks.StateWord(o).Length > 0 ? " · " : "") + "Clash" : "")</td>
            </tr>
        }
    </tbody>
</table>
</div>
@code {
    [Parameter, EditorRequired] public WeekModel M { get; set; } = default!;
    [Parameter, EditorRequired] public Workspace W { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnOpen { get; set; }
    [Parameter] public IReadOnlySet<Guid> Chosen { get; set; } = new HashSet<Guid>();
    private string _sort = "when";
    private bool _desc;

    private static readonly (string, string)[] Columns =
        [("when", "Day"), ("time", "Time"), ("title", "Session"), ("for", "For"), ("room", "Room"), ("who", "In the room"), ("state", "")];

    private void SortBy(string key)
    {
        if (_sort == key) _desc = !_desc; else { _sort = key; _desc = false; }
    }

    private IEnumerable<Occurrence> Sorted()
    {
        var t = W.T;
        IOrderedEnumerable<Occurrence> q = _sort switch
        {
            "title" => M.Visible.OrderBy(o => Looks.Title(t, o.Session), NameOrder.Comparer),
            "for" => M.Visible.OrderBy(o => Looks.Audience(t, o.Session), NameOrder.Comparer),
            "room" => M.Visible.OrderBy(o => Looks.Room(t, o.Session), NameOrder.Comparer),
            "who" => M.Visible.OrderBy(o => Looks.Names(t, o.InTheRoom), NameOrder.Comparer),
            "time" => M.Visible.OrderBy(o => o.Start),
            "state" => M.Visible.OrderBy(o => Looks.StateWord(o), NameOrder.Comparer),
            _ => M.Visible.OrderBy(o => o.Date).ThenBy(o => o.Start),
        };
        var list = q.ThenBy(o => o.Date).ThenBy(o => o.Start).ThenBy(o => o.Session.Id).ToList();
        if (_desc) list.Reverse();
        return list;
    }
}
