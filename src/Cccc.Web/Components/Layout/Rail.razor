@inject NavigationManager Nav
<nav class="rail @(_open ? "open" : "")" aria-label="Main" data-testid="rail">
    <div class="rail-head">
        <a class="rail-mark" href="/" title="The week"><img src="icons/cccc-mark.png" alt="" width="22" height="22" /> <span>CCCC Scheduler</span></a>
        <button class="rail-toggle" type="button" @onclick="() => _open = !_open" aria-expanded="@(_open ? "true" : "false")" aria-label="Menu">☰</button>
    </div>
    <div class="rail-body" @onclick="() => _open = false">
        @if (W.Project is not null)
        {
            <div class="rail-project" title="The timetable everybody is looking at">@W.ProjectName</div>
        }
        <div class="rail-section">Schedule</div>
        <NavLink class="rail-link" href="" Match="NavLinkMatch.All" data-testid="nav-week">Week</NavLink>
        @if (W.Access.FacilitatorId is not null)
        {
            <NavLink class="rail-link" href="my-week" data-testid="nav-my-week">My week</NavLink>
        }
        <NavLink class="rail-link" href="registers" data-testid="nav-registers">Registers</NavLink>
        @if (W.Access.MayEdit)
        {
            <NavLink class="rail-link" href="cover" data-testid="nav-cover">Cover</NavLink>
        }
        @if (W.Access.MayUseAdminTools)
        {
            <div class="rail-section">Manage</div>
            <NavLink class="rail-link" href="data" data-testid="nav-data">Data</NavLink>
            <NavLink class="rail-link" href="reports" data-testid="nav-reports">Reports</NavLink>
            <NavLink class="rail-link" href="admin" data-testid="nav-admin">Administration</NavLink>
        }
        <div class="rail-foot">
            <div class="rail-me" data-testid="signed-in-as">
                <span class="disc">@Initials(W.Access.Display)</span>
                <span><b>@W.Access.Display</b><small>@RoleName</small></span>
            </div>
            <label class="rail-theme"><span>Theme</span>
                <select data-theme-picker aria-label="Theme">
                    <option>Setsquare Dark</option>
                    <option>Chalkline Dark</option>
                    <option>Instrument Dark</option>
                    <option>Sandtable Dark</option>
                </select>
            </label>
            <a class="rail-link small" href="passphrase" data-enhance-nav="false" target="_self">Change passphrase</a>
            <form method="post" action="signout" class="rail-signout">
                <AntiforgeryToken />
                <button type="submit" class="rail-link small" data-testid="sign-out">Sign out</button>
            </form>
        </div>
    </div>
</nav>

@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
    private bool _open;

    private string RoleName => W.Access.Role switch
    {
        Role.Administrator => "Administrator",
        Role.Editor => "Editor",
        Role.Viewer => "Viewer",
        _ => "",
    };

    public static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
