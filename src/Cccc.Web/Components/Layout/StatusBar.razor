@inject FollowStatus Follow
<footer class="status" data-testid="status-bar">
    @if (W.Project is { } p)
    {
        var others = p.Present(TimeSpan.FromMinutes(2)).Where(n => n != W.Access.Display).ToList();
        @if (W.Access.Following)
        {
            @if (Follow.Problem is not null)
            {
                <span class="status-item warn" data-testid="status-following" title="@(W.Access.MaySeeSystem ? Follow.Problem : null)">Nothing from the current app since @(Follow.Checked is { } good ? W.Clock.Describe(good) : "this app started")</span>
            }
            else
            {
                <span class="status-item" data-testid="status-following"><span class="dot live"></span> Follows the current app</span>
            }
        }
        @if (others.Count > 0)
        {
            <span class="status-item" data-testid="also-here"><span class="dot live"></span> Also here: @string.Join(", ", others)</span>
        }
        @if (p.LastChange is { } c)
        {
            <span class="status-item muted">Last change @W.Clock.Describe(c.At) by @W.NameOf(c.By)</span>
        }
        @if (!W.Access.Following)
        {
            <span class="status-item muted">Every change is kept as it is made</span>
        }
    }
</footer>
@code {
    [CascadingParameter] public Workspace W { get; set; } = default!;
}
