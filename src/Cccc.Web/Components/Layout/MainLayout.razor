@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider Auth
@inject AccountDirectory Accounts
@inject ProjectChoice Choice
@inject TabTimetable Tab
@inject Cccc.Web.Features.Plan.PlanView Plan
@inject LiveProjects Live
@inject IJSRuntime JS
@inject SchoolClock Clock
@inject Toasts ToastList
@inject NavigationManager Nav
@inject ProjectStore Store
@inject FollowStatus Follow

@if (_ws is null)
{
    <div class="loading">Opening the timetable…</div>
}
else
{
    <CascadingValue Value="_ws">
        <div class="shell" data-testid="shell">
            <TopBar />
            <div class="shell-main">
                <LookingBand />
                <main class="shell-page">
                    @if (_ws.Project is null && !IsAdministrationPage)
                    {
                        <NoProject />
                    }
                    else
                    {
                        @Body
                    }
                </main>
                <StatusBar />
            </div>
        </div>
        <Cccc.Web.Features.Find.FindPalette />
        <DialogHost />
        <ToastHost />
    </CascadingValue>
}

@code {
    private Workspace? _ws;
    private LiveProject? _subscribed;
    private Timer? _presence;
    private Timer? _minute;

    private bool IsAdministrationPage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.Ordinal);

    // What sessionStorage holds for the tab, so it is written only when the tab's look changes.
    private string? _remembered;
    private const string LookingKey = "cccc.looking";

    protected override async Task OnInitializedAsync()
    {
        Auth.AuthenticationStateChanged += OnAuthChanged;
        Choice.Moved += OnProjectMoved;
        Tab.Moved += OnProjectMoved;
        // A reload keeps the timetable the tab was looking at, and the plan's day. Nothing is drawn before the
        // circuit is connected (App.razor), so the tab's own storage can be read before the first workspace is
        // built, and anything that moves the plan from here on starts from the day the tab was really on.
        try
        {
            var day = await JS.InvokeAsync<string?>("ccccShell.recall", "cccc.day");
            Plan.Start(Clock.Today);
            if (DateOnly.TryParseExact(day, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d)
                && !Cccc.Domain.Week.IsScratch(d)) Plan.GoTo(d);
            _remembered = await JS.InvokeAsync<string?>("ccccShell.recall", LookingKey);
            // "id" or "id|day before", as RememberAsync wrote it.
            var parts = (_remembered ?? "").Split('|');
            if (Guid.TryParse(parts[0], out var looking))
                Tab.Restore(looking, parts.Length > 1 && DateOnly.TryParseExact(parts[1], "yyyy-MM-dd", out var before) ? before : null);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException) { }
        await BuildAsync();
        _presence = new Timer(_ => InvokeAsync(() => { if (_ws is { Project: { } p }) p.Here(_ws.Access.Display); }), null, TimeSpan.Zero, TimeSpan.FromSeconds(30));
        _minute = new Timer(_ => InvokeAsync(() => { StateHasChanged(); ArmMinute(); }), null, Timeout.Infinite, Timeout.Infinite);
        ArmMinute();
    }

    // What is on now is worked out on the server, so every page is drawn again as each minute turns: a
    // screen left open all day keeps up with the clock beside it, and with the date after midnight.
    // Copenhagen is a whole number of hours from UTC, so its minutes turn when UTC's do.
    private void ArmMinute()
    {
        var into = TimeSpan.FromTicks(Clock.Now.UtcTicks % TimeSpan.TicksPerMinute);
        try { _minute?.Change(TimeSpan.FromMinutes(1) - into + TimeSpan.FromMilliseconds(250), Timeout.InfiniteTimeSpan); }
        catch (ObjectDisposedException) { }
    }

    private async Task BuildAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var account = AccountClaims.Current(state.User, Accounts);
        if (account is null)
        {
            Nav.NavigateTo("/signin", forceLoad: true);
            return;
        }
        var access = new Access(account);
        // Which timetable this tab shows is one rule (ProjectChoice.ShownId): the one it is looking at while
        // its account may see it, otherwise the one open for everybody.
        var openId = Choice.OpenId();
        var shownId = Choice.ShownId(Tab.LookingAt, access);
        // Let go of it once it cannot be shown (deleted, or the account may no longer look away) and once it
        // is the open one, so opening another for everybody later never sends this tab back to it.
        if (Tab.LookingAt is { } looking && (looking != shownId || looking == openId))
        {
            Tab.Drop();
            if (looking != openId && Store.Find(looking) is not { Deleted: null })
                ToastList.Warn("The timetable this tab was looking at has been deleted, so the tab is back on the one open for everybody.");
        }
        var project = shownId is { } id ? Live.Get(id) : null;
        if (!ReferenceEquals(project, _subscribed))
        {
            if (_subscribed is not null)
            {
                _subscribed.ChangedEvent -= OnChanged;
                _subscribed.Left(account.Display);
            }
            if (project is not null) project.ChangedEvent += OnChanged;
            _subscribed = project;
        }
        // The timetable kept the same as the current app's is changed there, never here (Access.Following).
        bool following = Follow.On && project is not null && Follower.FollowedId(Store) == project.Id;
        bool away = project is not null && project.Id != openId;
        _ws = new Workspace(access with { Following = following }, project, Clock, ToastList, Accounts) { LookingAway = away };
        project?.Here(account.Display);
        await RememberAsync(!away ? "" : Tab.DayBefore is { } before ? $"{project!.Id}|{before:yyyy-MM-dd}" : project!.Id.ToString());
    }

    private async Task RememberAsync(string value)
    {
        if ((_remembered ?? "") == value) return;
        _remembered = value;
        try { await JS.InvokeVoidAsync("ccccShell.remember", LookingKey, value); }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException) { }
    }

    private void OnChanged(Changed c) => _ = InvokeAsync(StateHasChanged);

    private void OnProjectMoved() => _ = InvokeAsync(async () => { await BuildAsync(); StateHasChanged(); });

    private void OnAuthChanged(Task<AuthenticationState> t) => _ = InvokeAsync(async () =>
    {
        var state = await t;
        if (AccountClaims.Current(state.User, Accounts) is null) Nav.NavigateTo("/signin", forceLoad: true);
    });

    public void Dispose()
    {
        Auth.AuthenticationStateChanged -= OnAuthChanged;
        Choice.Moved -= OnProjectMoved;
        Tab.Moved -= OnProjectMoved;
        if (_subscribed is not null) _subscribed.ChangedEvent -= OnChanged;
        _presence?.Dispose();
        _minute?.Dispose();
        if (_ws is { Project: { } p }) p.Left(_ws.Access.Display);
    }
}
