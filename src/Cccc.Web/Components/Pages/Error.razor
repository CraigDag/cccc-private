@page "/error"
@layout Cccc.Web.Features.SignIn.BareLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Something went wrong · CCCC Scheduler</PageTitle>
<h1>Something went wrong</h1>
<p>The page could not be shown. Nothing you changed before this was lost: every change is stored the moment it is made.</p>
<p><a class="btn" href="/">Back to the week</a></p>
@if (HttpContext?.TraceIdentifier is { } id)
{
    <p class="muted">Reference for whoever looks after the server: <code>@id</code></p>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
